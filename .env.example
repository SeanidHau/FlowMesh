# 仅用于本地 Docker Compose 开发。复制为 .env 后再填写实际值。
# 不要将 .env 或任何真实凭据提交到 Git。

POSTGRES_USER=flowmesh
POSTGRES_PASSWORD=change-me
POSTGRES_DB=flowmesh

# 各服务业务数据库账号密码（NOSUPERUSER，仅拥有各自 schema）
IAM_DB_PASSWORD=change-me-iam
SUPPLIER_DB_PASSWORD=change-me-supplier
WORKFLOW_DB_PASSWORD=change-me-workflow
RISK_DB_PASSWORD=change-me-risk
AUDIT_DB_PASSWORD=change-me-audit
# 生命周期维护账号密码；该账号不是超级用户，只能清理明确授予的消息与幂等表。
RETENTION_DB_PASSWORD=change-me-retention

# Redis 认证密码（登录限流使用）
REDIS_PASSWORD=change-me-redis

# Gateway 全局 Redis 令牌桶限流；公网环境应由 Ingress 覆写 X-Real-IP。
FLOWMESH_GATEWAY_RATE_LIMIT_REPLENISH_RATE=100
FLOWMESH_GATEWAY_RATE_LIMIT_BURST_CAPACITY=200
FLOWMESH_GATEWAY_RATE_LIMIT_REQUESTED_TOKENS=1
FLOWMESH_GATEWAY_CLIENT_IP_HEADER=X-Real-IP

# Grafana 仅在 observability profile 启用时使用
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# OpenTelemetry 默认关闭；接入 Collector 后再同时开启 Trace 和 OTLP 导出。
FLOWMESH_TRACING_ENABLED=false
FLOWMESH_OTEL_EXPORT_ENABLED=false
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
FLOWMESH_TRACING_SAMPLING_PROBABILITY=0.1
FLOWMESH_OTEL_CONNECT_TIMEOUT=2s
FLOWMESH_OTEL_EXPORT_TIMEOUT=5s

# MinIO 对象存储（供应商材料）
MINIO_ROOT_USER=flowmesh
MINIO_ROOT_PASSWORD=change-me-minio

# 使用 `openssl rand -base64 32` 生成；密钥必须是至少 32 字节随机数据的 Base64 编码。
JWT_SIGNING_KEY=replace-with-base64-encoded-random-secret
JWT_ISSUER=flowmesh-local

ROCKETMQ_NAMESRV_ADDR=localhost:9876
FLOWMESH_OUTBOX_ENABLED=true
FLOWMESH_SUPPLIER_CONSUMER_ENABLED=true
FLOWMESH_WORKFLOW_OUTBOX_ENABLED=true
FLOWMESH_WORKFLOW_CONSUMER_ENABLED=true
FLOWMESH_RISK_CONSUMER_ENABLED=true
FLOWMESH_RISK_OUTBOX_ENABLED=true
FLOWMESH_RISK_FAULT_INJECTION_ENABLED=false
# 故障演练时才开启；支持 FAIL 或 TIMEOUT，默认保持关闭。
FLOWMESH_RISK_FAULT_INJECTION_MODE=FAIL
FLOWMESH_RISK_FAULT_INJECTION_DELAY=0s
FLOWMESH_AUDIT_CONSUMER_ENABLED=true
# 本地 Redis 故障时默认降级放行；生产 Helm 默认关闭，避免绕过登录保护。
FLOWMESH_LOGIN_RATE_LIMIT_FAIL_OPEN=true

# 材料上传安全扫描；开启后需同时启动 Compose 的 documents profile。
FLOWMESH_FILE_SCAN_ENABLED=false
FLOWMESH_OBJECT_STORAGE_READINESS_ENABLED=true

# Compose 本地演示初始化。生产环境必须保持 false。
FLOWMESH_DEMO_DATA_ENABLED=true
