{
  "name": "flowmesh-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "FlowMesh supplier onboarding desktop console",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "typecheck": "vue-tsc --noEmit",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.node.json",
    "build": "npm run typecheck && npm run build:renderer && npm run build:electron",
    "package": "npm run build && electron-builder",
    "preview": "vite preview"
  },
  "dependencies": {
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "concurrently": "^10.0.5",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.2",
    "vite": "^8.2.2",
    "vue-tsc": "^3.3.11",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.flowmesh.desktop",
    "productName": "FlowMesh",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office"
    }
  }
}
