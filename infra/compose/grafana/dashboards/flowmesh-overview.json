  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "flowmesh-prometheus"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 6}]}}, "overrides": []},
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0},
      "id": 1,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"expr": "sum(up{job=~\"flowmesh-.*\"})", "legendFormat": "UP services", "refId": "A"}],
      "title": "Healthy services",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "flowmesh-prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps", "color": {"mode": "palette-classic"}}, "overrides": []},
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0},
      "id": 2,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [{"expr": "sum by (job) (rate(http_server_requests_seconds_count{job=~\"flowmesh-.*\"}[5m]))", "legendFormat": "{{job}}", "refId": "A"}],
      "title": "HTTP request rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "flowmesh-prometheus"},
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0},
      "id": 3,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"expr": "sum(flowmesh_outbox_pending)", "legendFormat": "pending", "refId": "A"}],
      "title": "Outbox backlog",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "flowmesh-prometheus"},
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0},
      "id": 4,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"expr": "sum(flowmesh_outbox_dead_lettered_current)", "legendFormat": "dead-lettered", "refId": "A"}],
      "title": "Dead-letter backlog",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "flowmesh-prometheus"},
      "fieldConfig": {"defaults": {"unit": "ops", "color": {"mode": "palette-classic"}}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5},
      "id": 5,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"expr": "sum by (consumer) (rate(flowmesh_messaging_failed_total[5m]))", "legendFormat": "failed {{consumer}}", "refId": "A"},
        {"expr": "sum by (consumer) (rate(flowmesh_messaging_duplicate_total[5m]))", "legendFormat": "duplicate {{consumer}}", "refId": "B"}
      ],
      "title": "Message failure and duplicate rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "flowmesh-prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps", "color": {"mode": "palette-classic"}}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5},
      "id": 6,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"expr": "sum by (job) (rate(http_server_requests_seconds_count{job=~\"flowmesh-.*\",status=~\"5..\"}[5m]))", "legendFormat": "5xx {{job}}", "refId": "A"},
        {"expr": "sum by (service) (rate(flowmesh_outbox_confirmation_failed_total[5m]))", "legendFormat": "outbox confirmation {{service}}", "refId": "B"}
      ],
      "title": "Server errors and outbox confirmation failures",
      "type": "timeseries"
    }
