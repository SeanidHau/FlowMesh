<?xml version="1.0" encoding="UTF-8"?>
<!--
  作用：IAM 服务模块。
  负责本地用户、角色、JWT Access Token 和 Refresh Token 生命周期。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.flowmesh</groupId>
    <artifactId>flowmesh</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>iam-service</artifactId>

  <name>FlowMesh IAM Service</name>
  <description>Authentication, authorization and tenant identity service.</description>

  <dependencies>
    <!-- 作用：提供 REST API。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- 作用：提供请求参数校验，例如用户名和密码不能为空。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- 作用：提供密码哈希、认证与授权基础设施。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>

    <!-- 作用：提供用户、角色和 Refresh Token 的持久化能力。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>

    <!-- 作用：暴露健康检查，供 Docker Compose 和 Kubernetes 探针使用。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- 作用：管理 IAM Schema 的版本化数据库迁移。 -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>

    <!-- 作用：Flyway 10+ 将 PostgreSQL 支持拆为独立工件，需显式引入。 -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <!-- 作用：生产环境 PostgreSQL JDBC 驱动。 -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- 作用：引用跨服务共享的安全上下文、JWT 基础设施和错误模型。 -->
    <dependency>
      <groupId>com.flowmesh</groupId>
      <artifactId>flowmesh-common</artifactId>
    </dependency>

    <!-- 作用：JUnit、Mockito、Spring Boot 测试基础设施。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- 作用：测试 Spring Security 认证和授权行为。 -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- 作用：集成测试使用 Testcontainers 真实 PostgreSQL，验证 Flyway 迁移、RLS 和种子数据。 -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- 作用：将 IAM 服务打包为可执行 Spring Boot JAR。 -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
