<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.flowmesh.iam.repository.TenantRepository">
  <resultMap id="tenantResult" type="com.flowmesh.iam.domain.tenant.Tenant">
    <id property="id" column="id" />
    <result property="name" column="name" />
    <result property="status" column="status" />
    <result property="createdAt" column="created_at" />
    <result property="updatedAt" column="updated_at" />
  </resultMap>

  <insert id="insert" parameterType="com.flowmesh.iam.domain.tenant.Tenant">
    INSERT INTO tenants (id, name, status, created_at, updated_at)
    VALUES (#{id}, #{name}, #{status}, #{createdAt}, #{updatedAt})
  </insert>

  <select id="findById" resultMap="tenantResult">
    SELECT id, name, status, created_at, updated_at
    FROM tenants
    WHERE id = #{id}
  </select>
</mapper>
