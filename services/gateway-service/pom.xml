<?xml version="1.0" encoding="UTF-8"?>
<!--
  作用：统一外部 API 入口，负责服务路由、入口超时和请求头透传。
  业务认证仍由各领域服务完成，避免网关复制 IAM 领域逻辑。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.flowmesh</groupId>
    <artifactId>flowmesh</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>gateway-service</artifactId>
  <name>FlowMesh Gateway Service</name>
  <description>Unified API entry point for FlowMesh domain services.</description>

  <dependencies>
    <!-- 作用：提供基于 Reactor Netty 的 Spring Cloud Gateway 路由能力。 -->
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-gateway-server-webflux</artifactId>
    </dependency>

    <!-- 作用：暴露网关健康检查和 Prometheus 指标。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- 作用：为 Gateway 提供可选 OpenTelemetry HTTP Trace 采集和 OTLP 导出。 -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-tracing-bridge-otel</artifactId>
    </dependency>

    <!-- 作用：将 Gateway 采样后的 Trace 发送到 OpenTelemetry Collector。 -->
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-exporter-otlp</artifactId>
    </dependency>

    <!-- 作用：提供网关单元测试和 Spring Boot 测试基础设施。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- 作用：将 Gateway 服务打包为可执行 Spring Boot JAR。 -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
