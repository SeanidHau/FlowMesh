<?xml version="1.0" encoding="UTF-8"?>
<!--
  作用：跨服务共享的技术契约模块。
  只允许放置安全上下文、事件信封、错误模型等无领域归属类型。
  不允许放置供应商、审批等领域实体。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.flowmesh</groupId>
    <artifactId>flowmesh</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>flowmesh-common</artifactId>
  <packaging>jar</packaging>

  <name>FlowMesh Common</name>
  <description>Shared technical contracts for FlowMesh services.</description>

  <dependencies>
    <!-- 作用：提供 @ConfigurationProperties 等 Spring Boot 配置契约。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot</artifactId>
    </dependency>

    <!-- 作用：提供共享 PostgreSQL UUID TypeHandler 所需的 MyBatis API。 -->
    <dependency>
      <groupId>org.mybatis</groupId>
      <artifactId>mybatis</artifactId>
    </dependency>

    <!-- 作用：提供 @NotBlank / @NotNull 校验注解。 -->
    <dependency>
      <groupId>jakarta.validation</groupId>
      <artifactId>jakarta.validation-api</artifactId>
    </dependency>

    <!-- 作用：提供 JwtAuthenticationFilter 所需的 Spring Security 过滤器基类。 -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-web</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-core</artifactId>
    </dependency>

    <!-- 作用：Servlet API，JwtAuthenticationFilter 所需。 -->
    <dependency>
      <groupId>jakarta.servlet</groupId>
      <artifactId>jakarta.servlet-api</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- 作用：JWT 签发与解析 API。 -->
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-api</artifactId>
    </dependency>

    <!-- 作用：JWT 运行时实现。 -->
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-impl</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- 作用：JWT Payload 的 Jackson JSON 编解码。 -->
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-jackson</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- 作用：JwtAuthenticationFilter 序列化 ErrorResponse。 -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>

    <!-- 作用：公共模块单元测试。 -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
