<?xml version="1.0" encoding="UTF-8"?>
<!--
  作用：FlowMesh 的 Maven 聚合根。
  统一 Java、Spring Boot、插件和依赖版本；本身不承载业务代码。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <!--
    作用：继承 Spring Boot 的依赖版本管理和 Maven 插件默认配置。
    后续子模块只继承本项目，不直接继承 Spring Boot。
  -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>com.flowmesh</groupId>
  <artifactId>flowmesh</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>FlowMesh</name>
  <description>Cloud-native supplier onboarding and workflow orchestration platform.</description>

  <!--
    作用：Maven 聚合模块。
    新服务创建后，在这里追加模块路径。
  -->
  <modules>
    <module>services/flowmesh-common</module>
    <module>services/gateway-service</module>
    <module>services/risk-service</module>
    <module>services/notification-audit-service</module>
    <module>services/iam-service</module>
    <module>services/supplier-service</module>
    <module>services/workflow-service</module>
  </modules>

  <properties>
    <!-- 作用：统一后端语言版本。 -->
    <java.version>21</java.version>

    <!-- 作用：后续 IAM 服务签发和校验 JWT 时使用。 -->
    <jjwt.version>0.12.6</jjwt.version>

    <!-- 作用：统一 Apache RocketMQ Spring 集成版本。 -->
    <rocketmq.spring.version>2.3.6</rocketmq.spring.version>

    <!-- 作用：统一 MyBatis Spring Boot 集成版本。 -->
    <mybatis.spring.version>3.0.4</mybatis.spring.version>
    <mybatis.core.version>3.5.17</mybatis.core.version>

    <!-- 作用：在本地、IDEA 与 CI 中统一校验构建运行时。 -->
    <maven.enforcer.version>3.6.3</maven.enforcer.version>
    <!-- 作用：统一 Spring Cloud Gateway 与 Spring Boot 3.5 的兼容版本。 -->
    <spring-cloud.version>2025.0.3</spring-cloud.version>
    <!-- 作用：覆盖 Spring Boot BOM 中的 Netty 补丁版本，修复当前高危/严重漏洞。 -->
    <netty.version>4.1.138.Final</netty.version>
    <!-- 作用：覆盖 Spring Boot BOM 中的 Tomcat 和 PostgreSQL JDBC 补丁版本。 -->
    <tomcat.version>10.1.59</tomcat.version>
    <postgresql.version>42.7.12</postgresql.version>
    <!-- 作用：统一 RocketMQ 传递引入的 gRPC、Protobuf、BeanUtils 和 LZ4 安全版本。 -->
    <grpc.version>1.75.0</grpc.version>
    <protobuf.version>3.25.5</protobuf.version>
    <commons-beanutils.version>1.11.0</commons-beanutils.version>
    <lz4.version>1.8.1</lz4.version>
    <rocketmq.lz4.version>1.10.1</rocketmq.lz4.version>
    <logback.version>1.5.34</logback.version>
    <bouncycastle.version>1.80.2</bouncycastle.version>
    <!-- 作用：统一 MinIO Java SDK 版本，用于供应商材料对象存储。 -->
    <minio.version>8.6.0</minio.version>

    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!--
        作用：导入 Spring Cloud BOM，避免 Gateway 的传递依赖出现版本漂移。
      -->
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- 作用：统一 RocketMQ 传递依赖使用的 gRPC 组件补丁版本。 -->
      <dependency>
        <groupId>io.grpc</groupId>
        <artifactId>grpc-bom</artifactId>
        <version>${grpc.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- 作用：确保 RocketMQ 传递依赖不会回退到存在漏洞的旧组件。 -->
      <dependency>
        <groupId>com.google.protobuf</groupId>
        <artifactId>protobuf-java</artifactId>
        <version>${protobuf.version}</version>
      </dependency>
      <dependency>
        <groupId>com.google.protobuf</groupId>
        <artifactId>protobuf-java-util</artifactId>
        <version>${protobuf.version}</version>
      </dependency>
      <dependency>
        <groupId>commons-beanutils</groupId>
        <artifactId>commons-beanutils</artifactId>
        <version>${commons-beanutils.version}</version>
      </dependency>
      <!-- 作用：覆盖 RocketMQ 使用的 LZ4 实现，修复输出缓冲区未清理漏洞。 -->
      <dependency>
        <groupId>at.yawk.lz4</groupId>
        <artifactId>lz4-java</artifactId>
        <version>${rocketmq.lz4.version}</version>
      </dependency>
      <!-- 作用：覆盖 RocketMQ 5.3.x 传递的旧版 LZ4，修复越界读写漏洞。 -->
      <dependency>
        <groupId>org.lz4</groupId>
        <artifactId>lz4-java</artifactId>
        <version>${lz4.version}</version>
      </dependency>
      <!-- 作用：显式锁定日志组件补丁版本，避免镜像扫描读取旧的传递元数据。 -->
      <dependency>
        <groupId>ch.qos.logback</groupId>
        <artifactId>logback-classic</artifactId>
        <version>${logback.version}</version>
      </dependency>
      <dependency>
        <groupId>ch.qos.logback</groupId>
        <artifactId>logback-core</artifactId>
        <version>${logback.version}</version>
      </dependency>
      <!-- 作用：覆盖 MinIO 传递引入的 Bouncy Castle 安全补丁版本。 -->
      <dependency>
        <groupId>org.bouncycastle</groupId>
        <artifactId>bcprov-jdk18on</artifactId>
        <version>${bouncycastle.version}</version>
      </dependency>

      <!--
        作用：子模块引用公共契约模块时统一版本。
        防止多个服务使用不同的内部模块版本。
      -->
      <dependency>
        <groupId>com.flowmesh</groupId>
        <artifactId>flowmesh-common</artifactId>
        <version>${project.version}</version>
      </dependency>

      <!--
        作用：JJWT 不由 Spring Boot BOM 管理，因此在根工程统一版本。
      -->
      <dependency>
        <groupId>io.jsonwebtoken</groupId>
        <artifactId>jjwt-api</artifactId>
        <version>${jjwt.version}</version>
      </dependency>
      <dependency>
        <groupId>io.jsonwebtoken</groupId>
        <artifactId>jjwt-impl</artifactId>
        <version>${jjwt.version}</version>
      </dependency>
      <dependency>
        <groupId>io.jsonwebtoken</groupId>
        <artifactId>jjwt-jackson</artifactId>
        <version>${jjwt.version}</version>
      </dependency>

      <!-- 作用：统一消息服务使用的 RocketMQ Spring Starter 版本。 -->
      <dependency>
        <groupId>org.apache.rocketmq</groupId>
        <artifactId>rocketmq-spring-boot-starter</artifactId>
        <version>${rocketmq.spring.version}</version>
      </dependency>

      <!-- 作用：统一服务使用的 MyBatis Spring Boot Starter 版本。 -->
      <dependency>
        <groupId>org.mybatis.spring.boot</groupId>
        <artifactId>mybatis-spring-boot-starter</artifactId>
        <version>${mybatis.spring.version}</version>
      </dependency>
      <dependency>
        <groupId>org.mybatis</groupId>
        <artifactId>mybatis</artifactId>
        <version>${mybatis.core.version}</version>
      </dependency>

      <!--
        作用：Testcontainers 版本由 Spring Boot BOM 统一管理，
        各服务直接声明 testcontainers 依赖即可，无需在此导入 BOM。
      -->
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <!--
          作用：统一 Java 编译目标。
          Spring Boot 父 POM 已管理插件版本。
        -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <configuration>
            <release>${java.version}</release>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!--
        作用：在构建开始时校验 Java 与 Maven 版本，避免环境差异导致构建结果不一致。
        Java 21 是本项目约定的 LTS 运行时；Maven Wrapper 固定 Maven 3.9.16。
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${maven.enforcer.version}</version>
        <executions>
          <execution>
            <id>enforce-build-runtime</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[21,22)</version>
                  <message>FlowMesh 必须使用 Java 21 LTS 构建。请在 IDEA 或终端中选择 Temurin 21。</message>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9.0,4.0.0)</version>
                  <message>FlowMesh 需要 Maven 3.9.x。请使用 ./mvnw。</message>
                </requireMavenVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
